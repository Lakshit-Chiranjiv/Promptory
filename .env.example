# ─────────────────────────────────────────────────────────────────
#  PROMPTORY — .env.example
#
#  This is a TEMPLATE — it contains no real secrets.
#  It IS committed to git so other users know what to configure.
#
#  HOW TO USE:
#    1. Copy this file:   cp .env.example .env    (or duplicate manually)
#    2. Fill in your real values in .env
#    3. Never commit .env — it's in .gitignore
# ─────────────────────────────────────────────────────────────────


# ── LLM Provider ───────────────────────────────────────────────
# Which LLM provider you want Promptory to use for running test cases.
# Supported values: openai | anthropic | gemini | groq | ollama
LLM_PROVIDER=groq


# ── API Key ────────────────────────────────────────────────────
# Your API key for the provider above.
# For Ollama (local): leave this blank, it doesn't need a key.
LLM_API_KEY=your_api_key_here


# ── Model Name ─────────────────────────────────────────────────
# The specific model to use for this provider.
# Examples:
#   openai    → gpt-4o-mini
#   anthropic → claude-3-haiku-20240307
#   gemini    → gemini-1.5-flash
#   groq      → llama-3.1-8b-instant
#   ollama    → llama3
LLM_MODEL=llama-3.1-8b-instant


# ── Base URL (optional) ────────────────────────────────────────
# Only needed for Ollama (local) or custom OpenAI-compatible endpoints.
# Leave blank for all hosted providers (openai, anthropic, gemini, groq).
# Example for Ollama: http://localhost:11434
LLM_BASE_URL=
